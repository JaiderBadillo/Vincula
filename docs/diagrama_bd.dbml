  estado_laboral varchar(50)
  validado_por_ies boolean
  creado_en timestamptz
  url_diploma_pdf text [null]
  estado_verificacion varchar(30)
  numero_acta_grado varchar(60) [null]
  numero_libro_folio varchar(60) [null]
  fecha_grado date [null]
  fecha_verificacion timestamptz [null]
  verificado_por_usuario uuid [null]
  motivo_rechazo text [null]
