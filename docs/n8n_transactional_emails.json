          "combinator": "and",
          "conditions": [
            {
              "id": "4ae2e336-79c4-462c-8d74-ef982e9e4c36",
              "leftValue": "={{ $json.headers.authorization }}",
              "rightValue": "Bearer vincula_n8n_sec_2026_9b2ab61",
