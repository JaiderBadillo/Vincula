              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "f52d5db9-2031-4025-a172-228bc542617d",
              "leftValue": "={{ $json.body.tipo }}",
              "rightValue": "^(registro_egresado|registro_empresa|registro_ies|egresado_verificado|empresa_aprobada|ies_aprobada|fase_postulacion|vacante_publicada)$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "3f03cc4e-f08a-4e9b-90ee-67daaf8528d6",
              "leftValue": "={{ $json.body.html }}",
              "rightValue": "<html",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "e428117b-a593-4973-82b6-da45fe2f91e1",
      "name": "Validar origen",
