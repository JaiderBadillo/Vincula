      "typeVersion": 2.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "jaiderbadillo@gmail.com",
        "toEmail": "={{ $json.body.correo }}",
        "subject": "={{ $json.body.asunto }}",
        "emailFormat": "html",
        "html": "={{ $json.body.html }}\n",
        "options": {
          "allowUnauthorizedCerts": true
