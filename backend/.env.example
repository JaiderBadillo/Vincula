# ============================================================================
# Vincula Backend - Configuración de Entorno (.env)
# ============================================================================

# Entorno: development | production | testing
ENVIRONMENT=development
DEBUG=True

# Servidor FastAPI
PORT=8000
HOST=0.0.0.0

# Seguridad JWT
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_fuerte_de_al_menos_32_caracteres_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos PostgreSQL (Supabase / Local)
# Formato Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vincula_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/vincula_db

# Supabase Storage & Claves API (Para almacenamiento de PDFs: RUT, Cámara de Comercio, SNIES, Diplomas)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase
SUPABASE_STORAGE_BUCKET_DOCS=vincula-documentos-auditoria
SUPABASE_STORAGE_BUCKET_DIPLOMAS=vincula-diplomas-validados

# Orquestador n8n (Webhooks de Automatización de Correos y Notificaciones)
N8N_WEBHOOK_BASE_URL=https://tu-n8n.ejemplo.com/webhook
N8N_WEBHOOK_SECRET=token_secreto_para_firmar_eventos

# Google Gemini API (Para Embeddings Vectoriales text-embedding-004 de Matching Laboral)
GEMINI_API_KEY=tu-gemini-api-key-de-google-ai-studio
GEMINI_CHAT_MODEL=gemini-2.5-flash

